upstream javajs_application {
    server {{ reverse_proxy_upstream_host }}:{{ reverse_proxy_upstream_port }};
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Serveur HTTP : sert le défi ACME localement (webroot), puis proxy ou redirige
# vers HTTPS selon reverse_proxy_tls_enabled.
server {
    listen 80;
    listen [::]:80;

    server_name {{ reverse_proxy_domain }};

    client_max_body_size {{ reverse_proxy_client_max_body_size }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location = /reverse-proxy-health {
        access_log off;
        default_type text/plain;
        return 200 'bastion-reverse-proxy-ok';
    }

{% if reverse_proxy_tls_enabled | default(false) | bool %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    location / {
        proxy_pass http://javajs_application;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout {{ reverse_proxy_connect_timeout }}s;
        proxy_send_timeout {{ reverse_proxy_send_timeout }}s;
        proxy_read_timeout {{ reverse_proxy_read_timeout }}s;

        proxy_buffering off;
    }
{% endif %}
}

{% if reverse_proxy_tls_enabled | default(false) | bool %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name {{ reverse_proxy_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ reverse_proxy_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ reverse_proxy_domain }}/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    client_max_body_size {{ reverse_proxy_client_max_body_size }};

    location / {
        proxy_pass http://javajs_application;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout {{ reverse_proxy_connect_timeout }}s;
        proxy_send_timeout {{ reverse_proxy_send_timeout }}s;
        proxy_read_timeout {{ reverse_proxy_read_timeout }}s;

        proxy_buffering off;
    }

    location = /reverse-proxy-health {
        access_log off;
        default_type text/plain;
        return 200 'bastion-reverse-proxy-ok';
    }
}
{% endif %}
